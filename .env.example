# ============================================================================
# QR Menü / qr-menu_core — Environment Variables
# ============================================================================
# Bu dosyayı .env olarak kopyala ve değerleri doldur.
# .env ASLA commit edilmez (.gitignore'da).
#
# Kullanım:
#   cp .env.example .env
#   docker compose up
# ============================================================================

# ----- Django / Backend -----
# Rastgele 50+ karakter üret: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production-with-secrets-token-urlsafe
DJANGO_DEBUG=1                      # 0 prod, 1 local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.local

# ----- Database (PostgreSQL 16) -----
POSTGRES_DB=qr_menu
POSTGRES_USER=qr_menu
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL (Django'ya DRF/dj-database-url ile)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Bu değer backend container'ında okunur; `postgres` host adı docker network içindir.
DATABASE_URL=postgres://qr_menu:change-me-in-production@postgres:5432/qr_menu

# ----- Next.js / Frontend -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=tr
NEXT_PUBLIC_SUPPORTED_LOCALES=tr,en

# Frontend backend'den veri çekerken CORS için
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Object Storage (Sprint 5'te aktif olacak) -----
# Hetzner Storage Box / R3 / S3 — Sprint 5 kararı sonrası doldurulacak
STORAGE_BACKEND=local               # local | s3
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=

# ----- QR Menu public base URL (Sprint 5A) -----
# Menü sayfasının absolute origin'i. Production'da https://menu.example.com vb.
# QR kodlar bu base üzerinden /m/{business_slug}?branch=...&qr=... açacak.
PUBLIC_BASE_URL=http://localhost:3000

# ----- Analytics salt (Sprint 5A, D-017) -----
# IP + User-Agent hash'leri için salt. Production'da 32+ rastgele karakterle değiştir.
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANALYTICS_SALT=change-me-in-production-with-secrets-token-urlsafe

# ----- Email (opsiyonel, admin bildirimleri için) -----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend   # local
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend     # prod
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=noreply@qr-menu.local

# ----- Demo / Seed -----
DEMO_BUSINESS_SLUG=modern-cafe
DEMO_ADMIN_EMAIL=admin@modern-cafe.local
DEMO_ADMIN_PASSWORD=change-me-demo-only

# ----- Monitoring (Sprint 6'da aktif olacak) -----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
UPTIME_MONITOR_TOKEN=

# ----- AI PDF Menu Import (Sprint 7A — D-021) -----
# OpenAI primary. Sağlayıcı panele girip yeni secret key üret.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
# Anthropic fallback. OpenAI hata/ratelimit verdiğinde devreye girer.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# ----- Production-only -----
# Bu değişkenler sadece production docker-compose.production.yml'de set edilir
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=menu.example.com,api.example.com
# DATABASE_URL=postgres://...
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com