# ============================================================================
# QR Menü — production environment template (D-018, Sprint 6A).
#
# Usage on the VPS:
#   cp .env.production.example .env.production
#   $EDITOR .env.production        # fill in real values
#   chmod 600 .env.production
#   bash scripts/validate_prod_env.sh
#   docker compose --env-file .env.production -f docker-compose.production.yml up -d --build
#
# Keep every line `KEY=value` (or a `#` comment). Docker Compose refuses to
# read a file with any other kind of line.
#
# .env.production is in .gitignore (covered by the .env* catch-all). NEVER
# commit the real values. Rotate secrets quarterly and after any team change.
#
# Generating secrets:
#   DJANGO_SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(50))"
#   ANALYTICS_SALT:     python -c "import secrets; print(secrets.token_urlsafe(32))"
#   POSTGRES_PASSWORD:  python -c "import secrets; print(secrets.token_urlsafe(24))"
#   INTERNAL_API_TOKEN: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   PAYMENT_FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================================

# ----- Django / Backend -----
# Points the WSGI/ASGI workers at the production settings module.
DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_DEBUG defaults to 0 — leave at 0 unless you need emergency local
# debugging against a production-shaped config. NEVER set to 1 in real prod.
DJANGO_DEBUG=0
# Strong random value, 50+ chars. Required at startup (raises RuntimeError
# if missing or still the base.py placeholder).
DJANGO_SECRET_KEY=__REPLACE_WITH_OUTPUT_OF_secrets.token_urlsafe(50)__
# Comma-separated list of hostnames Django will accept. Must match the
# A-record domain(s) you've pointed at the VPS. The private-network names the
# stack itself uses (backend, localhost, 127.0.0.1) are added automatically;
# override that list with DJANGO_INTERNAL_HOSTS only if you rename services.
DJANGO_ALLOWED_HOSTS=menu.example.com

# ----- Database -----
# Postgres credentials — used both by the postgres container (env vars
# below) and by the backend via DATABASE_URL.
POSTGRES_DB=qr_menu
POSTGRES_USER=qr_menu
# Must be a strong password, 24+ chars. Keep this out of git.
POSTGRES_PASSWORD=__REPLACE_WITH_OUTPUT_OF_secrets.token_urlsafe(24)__
# Built by combining the values above. The host ``postgres`` is the docker
# service name, NOT localhost — backend talks to it over the docker network.
DATABASE_URL=postgres://qr_menu:__REPLACE_WITH_POSTGRES_PASSWORD__@postgres:5432/qr_menu

# ----- Analytics salt (D-017) -----
# Salt for IP / User-Agent hashing. Must stay stable for the lifetime of
# the deployment (changing it invalidates all historical analytics hashes).
ANALYTICS_SALT=__REPLACE_WITH_OUTPUT_OF_secrets.token_urlsafe(32)__

# ----- Frontend / CORS -----
# Public API base URL the browser sees. Single-domain setup uses the same
# domain as the menu; Caddy routes /api/* to the backend.
NEXT_PUBLIC_API_BASE_URL=https://menu.example.com
# Server-side API base URL used by Next.js Server Components to talk to
# the backend over the docker network without a host-loopback hop.
INTERNAL_API_BASE_URL=http://backend:8000
# Shared secret between the Next.js server and the backend. Every public page
# is rendered by the Next.js server, so without it the backend's per-IP rate
# limit counts ALL visitors as one client. Same value is read by both
# containers (docker-compose.production.yml passes it to the frontend). Keep it
# out of NEXT_PUBLIC_* and out of git.
INTERNAL_API_TOKEN=__REPLACE_WITH_OUTPUT_OF_secrets.token_urlsafe(32)__
# Seconds the Next.js server caches a public menu (0 disables). Menu edits made
# in the admin show up on the public page within this time. Default 10.
PUBLIC_MENU_CACHE_TTL_SECONDS=10
# Reverse proxies in front of Django whose X-Forwarded-For is trusted. Caddy is
# the only hop, so leave at 1. 0 = ignore X-Forwarded-For entirely.
TRUSTED_PROXY_COUNT=1
# Locale defaults — exposed to the browser bundle (NEXT_PUBLIC_*).
NEXT_PUBLIC_DEFAULT_LOCALE=tr
NEXT_PUBLIC_SUPPORTED_LOCALES=tr,en
# Allowed origins for CORS — must include the frontend's https origin.
# Comma-separated. NO trailing slashes. NO wildcards.
CORS_ALLOWED_ORIGINS=https://menu.example.com

# ----- Caddy / TLS -----
# Domain Caddy will issue a Let's Encrypt cert for. Must match the A record.
DOMAIN=menu.example.com
# (The Caddyfile does not set an ACME contact e-mail, so none is needed here.
# To receive Let's Encrypt expiry notices add a global `email` option there.)

# ----- Monitoring (optional) -----
# Leave SENTRY_DSN empty to disable Sentry entirely. When set, the backend
# SDK initialises with traces_sample_rate=SENTRY_TRACES_SAMPLE_RATE.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ----- Public base URL (D-017) -----
# Absolute origin the frontend uses to load menus and that QR codes target.
# REQUIRED: the backend refuses to start if this is missing or points at
# localhost (printed QR codes would otherwise open the printer's own computer).
# Same as NEXT_PUBLIC_API_BASE_URL in the single-domain setup. It is also baked
# into the frontend build as NEXT_PUBLIC_BASE_URL (canonical / hreflang / OG).
PUBLIC_BASE_URL=https://menu.example.com

# ----- AI PDF menu import (Sprint 7A — D-021) -----
# OpenAI primary (GPT-4o vision + structured JSON output).
OPENAI_API_KEY=__SET_IN_PRODUCTION__
OPENAI_DEFAULT_MODEL=gpt-4o
# Anthropic fallback (Claude 3.5 Sonnet). OpenAI rate-limit / error
# durumunda otomatik devreye girer.
ANTHROPIC_API_KEY=__SET_IN_PRODUCTION__
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# ----- Demo / seed -----
# Used by ``manage.py seed_demo`` (D-006 / D-015). These create the demo
# business + admin user. Safe to keep as defaults; they only run when you
# invoke the seed command.
DEMO_BUSINESS_SLUG=modern-cafe
DEMO_ADMIN_EMAIL=admin@modern-cafe.local
DEMO_ADMIN_PASSWORD=__CHANGE_ME_AFTER_FIRST_LOGIN__

# ----- Email (SMTP) -----
# Customer magic-link login e-mails are sent through this server. Without a
# working SMTP host customers are told "link sent" and nothing arrives (the
# failure is logged by the backend). Port 587 + STARTTLS is the default; for
# implicit TLS on port 465 set EMAIL_USE_TLS=0 and EMAIL_USE_SSL=1.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@menu.example.com
# Magic-link validity in minutes (also sets the customer session lifetime x4).
MAGIC_LINK_TTL_MINUTES=15

# ----- Online payment (disabled in V1) -----
# REQUIRED even while payments are off: the payment app encrypts stored
# provider credentials with this key. Without a stable value every gunicorn
# worker would invent its own and lose it on restart, so the backend refuses to
# start without it. Generate once and keep it (changing it makes saved
# credentials unreadable).
PAYMENT_FERNET_KEY=__REPLACE_WITH_OUTPUT_OF_Fernet.generate_key()__
# Optional until online payment is enabled for a plan.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
# Public origin Stripe redirects back to.
PAYMENT_WEBHOOK_BASE_URL=https://menu.example.com

# ----- AI Translate + Product Description (Sprint 9A — D-021 reuse) -----
# Kaynak metin uzunluğu üst sınırı. Default 2000.
AI_TRANSLATION_MAX_CHARS=2000
# Toplu description üretiminde tek istek başına max item. Default 50.
AI_DESCRIPTION_BULK_MAX_ITEMS=50
