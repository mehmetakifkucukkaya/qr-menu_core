# Public (browser-visible) API base URL. Used inside the browser bundle.
# In local dev: backend served by docker-compose on host port 8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-side API base URL. Used inside Next.js server components / route
# handlers. In docker-compose this resolves to the `backend` service over
# the internal Docker network, avoiding a host-loopback hop.
INTERNAL_API_BASE_URL=http://backend:8000

# Default locale when the request doesn't carry one (?locale=).
NEXT_PUBLIC_DEFAULT_LOCALE=tr
